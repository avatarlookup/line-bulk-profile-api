{
  "name": "LINE Bulk Avatar Analysis",
  "brand": "AvatarLookup",
  "repository": "avatarlookup/line-bulk-profile-api",
  "description": "Upload numbers and download the LINE profile data, avatar included.",
  "official_site": "https://avatarlookup.com",
  "landing_page": "https://avatarlookup.com/products/line_profile_batch",
  "canonical_docs": "https://avatarlookup.com/api-docs",
  "base_url": "https://avatarlookup.com",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async-bulk",
  "product": "line_profile_batch",
  "identifier_kind": "phone",
  "requires_country": true,
  "endpoints": {
    "submit": {
      "method": "POST",
      "path": "/api/v1/bulk-tasks"
    },
    "status": {
      "method": "GET",
      "path": "/api/v1/bulk-tasks/{id}"
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "min_items": 1000,
    "max_items": 100000,
    "poll_interval_seconds": 30,
    "file_formats": [
      "txt",
      "csv"
    ]
  },
  "result_fields": [
    {
      "name": "number",
      "example": "17253100591",
      "description": "The submitted number, exactly as it appeared in your file."
    },
    {
      "name": "activated",
      "example": "yes",
      "description": "Whether the number is registered on LINE."
    },
    {
      "name": "uid",
      "example": "ub2b4c718e837b7f19321820",
      "description": "Telegram user id."
    },
    {
      "name": "nickname",
      "example": "Kenji",
      "description": "Public display name on the profile."
    },
    {
      "name": "avatar",
      "example": "https://line.waavatar.xyz/v/example.jpg",
      "description": "Avatar URL."
    },
    {
      "name": "category",
      "example": "individual portrait",
      "description": "Avatar category, e.g. individual portrait."
    },
    {
      "name": "gender",
      "example": "female",
      "description": "Gender estimated from the avatar."
    },
    {
      "name": "age",
      "example": "72",
      "description": "Age band estimated from the avatar."
    },
    {
      "name": "skin_color",
      "example": "east_asian",
      "description": "Skin tone estimated from the avatar."
    },
    {
      "name": "hair_color",
      "example": "gray white",
      "description": "Hair colour estimated from the avatar."
    }
  ],
  "statuses": [
    "processing",
    "success",
    "failed"
  ],
  "pricing_url": "https://avatarlookup.com/pricing",
  "maintainer": "AvatarLookup",
  "license": "MIT",
  "last_reviewed": "2026-09-22"
}
